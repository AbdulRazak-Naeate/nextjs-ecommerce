{
  "pages": {
    "/(store)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(store)/page.css",
      "static/chunks/app/(store)/page.js"
    ],
    "/(store)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(store)/layout.js"
    ],
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/(auth)/sign-in/[[...sign-in]]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(auth)/sign-in/[[...sign-in]]/page.js"
    ],
    "/(auth)/sign-up/[[...sign-up]]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(auth)/sign-up/[[...sign-up]]/page.js"
    ],
    "/(store)/browse/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(store)/browse/page.css",
      "static/chunks/app/(store)/browse/page.js"
    ],
    "/(store)/cart/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(store)/cart/page.css",
      "static/chunks/app/(store)/cart/page.js"
    ],
    "/dashboard/seller/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/dashboard/seller/page.js"
    ],
    "/dashboard/seller/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/dashboard/seller/layout.js"
    ],
    "/dashboard/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/dashboard/layout.js"
    ],
    "/dashboard/seller/stores/[storeUrl]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/dashboard/seller/stores/[storeUrl]/page.js"
    ],
    "/dashboard/seller/stores/[storeUrl]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/dashboard/seller/stores/[storeUrl]/layout.js"
    ],
    "/dashboard/seller/stores/[storeUrl]/products/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/dashboard/seller/stores/[storeUrl]/products/page.css",
      "static/chunks/app/dashboard/seller/stores/[storeUrl]/products/page.js"
    ],
    "/(store)/product/[productSlug]/[variantSlug]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(store)/product/[productSlug]/[variantSlug]/page.css",
      "static/chunks/app/(store)/product/[productSlug]/[variantSlug]/page.js"
    ],
    "/(store)/seller/apply/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(store)/seller/apply/page.js"
    ]
  }
}